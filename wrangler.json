{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "amazing-interview-prep",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public"
  },
  "env": {
    "dev": {
      "name": "amazing-interview-prep-dev",
      "workers_dev": false,
      "assets": {
        "directory": "./public"
      },
      "preview_urls": false,
      "routes": [
        {
          "pattern": "interview-dev.szolotov.com",
          "custom_domain": true
        }
      ]
    },
    "stage": {
      "name": "amazing-interview-prep-stage",
      "workers_dev": false,
      "assets": {
        "directory": "./public"
      },
      "preview_urls": false,
      "routes": [
        {
          "pattern": "interview-stage.szolotov.com",
          "custom_domain": true
        }
      ]
    },
    "production": {
      "name": "amazing-interview-prep",
      "workers_dev": false,
      "preview_urls": false,
      "assets": {
        "directory": "./public"
      },
      "routes": [
        {
          "pattern": "interview.szolotov.com",
          "custom_domain": true
        }
      ]
    }
  }
}
